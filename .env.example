# URL do projeto do Supabase (ex: https://xyz.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Chave anônima / pública (anon/public key) do Supabase
VITE_SUPABASE_ANON_KEY=your-anon-key

# NÃO adicione chaves de API de terceiros aqui (Gemini, etc.) com o prefixo
# VITE_ — qualquer variável VITE_* vai para o bundle do navegador e fica
# pública. A chave do Gemini usada pela sincronização Grupo IB é lida como
# segredo da Edge Function (GEMINI_API_KEY via `supabase secrets set`), nunca
# como variável de build do front-end.

# Workspace deste deploy (ver src/config/branding.js). Este repo serve só o
# 'grupoib'. O banco Supabase é compartilhado com a Porto Terapia: o isolamento
# real dos dados é feito por RLS (workspace_scope em auth.users), não por esta
# variável, que só controla marca/branding e as unidades do login do quiosque.
VITE_WORKSPACE_ID=grupoib

# Recadastro de identidade (Hub de Gestão). Padrão DESLIGADO: só '1' liga (lido em tempo de build/execução
# via import.meta.env). Ligado, o supervisor com recadastro pendente é levado à página do Hub; qualquer
# falha de rede/timeout (3 s) segue o login normalmente. Quiosques e estagiário nominal ficam de fora.
VITE_GESTAO_RECADASTRO=0
# Opcionais: URL da função gestao-hub e único hostname aceito como destino do redirecionamento.
# VITE_GESTAO_HUB_URL=https://ivjvpdzsfjdpyabbzzuj.supabase.co/functions/v1/gestao-hub
# VITE_GESTAO_HUB_HOST=gestao.institutofacaamigos.com.br
